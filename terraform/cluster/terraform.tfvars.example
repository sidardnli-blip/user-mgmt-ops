# Kopieren nach terraform.tfvars und eigene Werte eintragen.
# ACHTUNG: terraform.tfvars ist per .gitignore ausgeschlossen.
# Den API Token NICHT hier eintragen, sondern:
#   PowerShell:  $env:TF_VAR_do_token = "dop_v1_...."

cluster_id         = "00000000-0000-0000-0000-000000000000"
cluster_name       = "user-mgmt-cluster"
region             = "fra1"
kubernetes_version = "1.34.1-do.0"
node_pool_name     = "pool-1"
node_size          = "s-2vcpu-4gb"
node_count         = 2
